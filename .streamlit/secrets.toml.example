# Renomeie este arquivo para `secrets.toml` e preencha os valores antes de subir o app.
# Este arquivo (`secrets.toml.example`) PODE ir para o git;
# o `secrets.toml` real deve permanecer fora do controle de versão.

[auth]
# Segredo HMAC do cookie de sessão. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = "troque-por-uma-string-aleatoria-longa"
